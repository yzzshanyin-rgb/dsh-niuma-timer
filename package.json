{
  "name": "dsh-niuma-timer",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "牛马费用计时器 — 输入月薪与上下班时间，实时显示今天已挣多少牛马费、本月累计多少，手帐风格贴在输入框下方。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "niuma",
    "salary",
    "worktimer"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzzshanyin-rgb/dsh-niuma-timer.git"
  },
  "homepage": "https://github.com/yzzshanyin-rgb/dsh-niuma-timer#readme",
  "bugs": {
    "url": "https://github.com/yzzshanyin-rgb/dsh-niuma-timer/issues"
  },
  "author": "yzzshanyin-rgb"
}

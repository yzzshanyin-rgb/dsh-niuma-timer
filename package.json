{
  "name": "dsh-niuma-timer",
  "version": "1.5.1",
  "private": false,
  "type": "module",
  "description": "DSH 插件 · 牛马费用计时器：工作计时、日薪换算、今日时间轴、下班保护与工作日历，配可配置的迷你仪表盘、工作日口径统一、首次引导、实时预览与未保存保护，支持跟随系统 / 浅色 / 深色三种主题，每个重要操作都有轻量反馈。全程零第三方运行时依赖。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "niuma",
    "salary",
    "worktimer"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzzshanyin-rgb/dsh-niuma-timer.git"
  },
  "homepage": "https://github.com/yzzshanyin-rgb/dsh-niuma-timer#readme",
  "bugs": {
    "url": "https://github.com/yzzshanyin-rgb/dsh-niuma-timer/issues"
  },
  "author": "yzzshanyin-rgb"
}

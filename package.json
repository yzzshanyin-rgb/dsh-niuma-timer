{
  "name": "dsh-niuma-timer",
  "version": "1.7.0",
  "private": false,
  "type": "module",
  "description": "DSH 插件 · 按月薪与计划工时实时预估收入，提供工作日历、下班提醒与主动加班计时。浏览器本地运行，零第三方运行时依赖。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "scripts/check-version.js"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "niuma",
    "salary",
    "worktimer"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzzshanyin-rgb/dsh-niuma-timer.git"
  },
  "homepage": "https://github.com/yzzshanyin-rgb/dsh-niuma-timer#readme",
  "bugs": {
    "url": "https://github.com/yzzshanyin-rgb/dsh-niuma-timer/issues"
  },
  "author": "yzzshanyin-rgb",
  "scripts": {
    "check:version": "node scripts/check-version.js",
    "prepack": "npm run check:version"
  }
}
